# ==========================================
# AWS Cloud Learning Lab - .gitignore
# ==========================================

# ---------- AWS ----------
.aws/
.aws-sam/
samconfig.toml
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# Never commit AWS credentials
credentials
config
*.pem
*.key

# ---------- Environment / Secrets ----------
.env
.env.*
!.env.example

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Python packaging
*.egg
*.egg-info/
dist/
build/
.eggs/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Type checking / linting
.mypy_cache/
.pyright/
.ruff_cache/

# ---------- Jupyter Notebook ----------
.ipynb_checkpoints/

# ---------- Node.js ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output
dist/
build/
.next/
.nuxt/
.cache/

# ---------- Java / Maven / Gradle ----------
target/
.gradle/
*.class

# ---------- IDE / Editors ----------
.vscode/
.idea/
*.iml

# macOS
.DS_Store

# Windows
Thumbs.db
Desktop.ini

# ---------- Logs ----------
*.log
logs/

# ---------- Temporary Files ----------
*.tmp
*.temp
*.swp
*.swo
*~

# ---------- Generated / Output Files ----------
output/
outputs/
generated/
*.zip

# ---------- Local Configuration ----------
*.local